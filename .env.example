# ============================================================================
# 可选：本地开发覆盖（developer overrides only）
#
# 打包给最终用户的 exe **不读 .env**——部署形态是本地单用户桌面应用，无 .env。
# 这里所有值都只是**开发时**对 app/core/config.py 代码默认值的临时覆盖；
# 全部留空 = 用代码默认值即可跑。
#
# API key 不在此兜底（N1，2026-08-13）：key 唯一来源 = 设置面板 → SQLite 设置表。
# 最终用户在设置界面填 key；这里的 OPENAI_API_KEY 仅为本地开发自测方便，**不进发布**。
# ============================================================================

# 应用
PROJECT_NAME=Career Nova2
DEBUG=true

# LLM（OpenAI 兼容端点，可指向 deepseek 等兼容服务）
OPENAI_API_KEY=
OPENAI_BASE_URL=
# 默认模型名为空：模型名只来自设置面板探测接口拉取（本地不存出厂默认，2026-08-12）
DEFAULT_LLM_MODEL=
DEFAULT_LLM_TEMPERATURE=0.2
MAX_TOKENS=2000
MAX_LLM_CALL_RETRIES=3
# 单次 LLM 调用总超时（秒）。代码默认 300——慢推理模型/识别任务单次可超 50s，留足余量。
LLM_TOTAL_TIMEOUT=300

# 日志
LOG_LEVEL=DEBUG
LOG_FORMAT=console

# 数据库（SQLite）。Electron 打包形态由 settings.json 的 data_dir 注入覆盖。
DATABASE_URL=sqlite+aiosqlite:///./data/career_nova.db
